{
  "name": "ai-project-hub",
  "version": "0.3.0",
  "description": "Local-first AI project workbench for Claude and ChatGPT Desktop",
  "author": "AI Project Hub",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/start-desktop.mjs",
    "start:web": "tsx server/index.ts --production",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "pack:desktop": "npm run build:desktop && electron-builder --config electron-builder.config.cjs --win --x64 --dir --publish never",
    "dist:desktop": "node scripts/release-source.cjs && npm run build:desktop && electron-builder --config electron-builder.config.cjs --win portable nsis --x64 --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:git-desktop": "node --import tsx scripts/git-desktop-smoke.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:ui": "tsx scripts/ui-fixtures.ts"
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  }
}
