{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true,
    "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"], "allowImportingTsExtensions": true
  },
  "include": ["src", "server", "shared", "desktop", "tests", "scripts", "vite.config.ts", "vitest.config.ts"]
}
